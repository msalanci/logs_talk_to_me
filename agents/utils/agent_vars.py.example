def build_bedrock_model(model_id: str, **settings):
    """A new BedrockModel for one agent, without the CountTokens call before every model call.

    Strands 1.39 calls Bedrock CountTokens before each model call unless told not to. The agent role may
    not call it, so every call failed and fell back to a local estimate that nothing reads. From Strands
    1.40 the call is off by default. Strands is imported here, not at the top: code that needs only this
    file's constants imports it without Strands.

    Args:
        model_id: The Bedrock model or inference profile ID, such as SUPERVISOR_MODEL.
        **settings: Further BedrockModel settings, such as max_tokens.

    Returns:
        The BedrockModel.
    """
    from strands.models import BedrockModel
    return BedrockModel(model_id=model_id, use_native_token_count=False, **settings)


