def extract_token_usage(result, agent_name: str) -> dict:
    """Log the token usage of the agent call that returned `result`, and add it to the question's receipt.

    Reads result.metrics.latest_agent_invocation.usage: this call only. accumulated_usage would be the agent's
    total since it was built, and the supervisor lives for the whole session, so a question would show every
    earlier one added in. Each model call's cache write or read goes on the receipt too, for the lines under the
    💰 line: Strands keeps one usage per call (its "cycle"); without per-call figures, the invocation's sums.

    Args:
        result: The AgentResult returned by agent(question).
        agent_name: Human-readable name for logging (e.g., "cloudtrail", "supervisor").

    Returns:
        Dict with inputTokens, outputTokens, totalTokens, cacheReadInputTokens and cacheWriteInputTokens (all
        int, 0 on failure). Prints one [LTTM:Tokens] line.
    """
    usage = {"inputTokens": 0, "outputTokens": 0, "totalTokens": 0,
             "cacheReadInputTokens": 0, "cacheWriteInputTokens": 0}
    try:
        invocation = result.metrics.latest_agent_invocation
        if invocation is not None:
            for key in usage:
                usage[key] = int(invocation.usage.get(key) or 0)
        print(
            f"[LTTM:Tokens] {agent_name} — "
            f"input={usage['inputTokens']}, "
            f"output={usage['outputTokens']}, "
            f"total={usage['totalTokens']}, "
            f"cache_read={usage['cacheReadInputTokens']}, "
            f"cache_write={usage['cacheWriteInputTokens']}",
            flush=True,
        )
        request_context.current().receipt.add_tokens(agent_name, usage)
        cycles = (getattr(invocation, "cycles", None) or []) if invocation is not None else []
        writes = [int(c.usage.get("cacheWriteInputTokens") or 0) for c in cycles] or [usage["cacheWriteInputTokens"]]
        reads = [int(c.usage.get("cacheReadInputTokens") or 0) for c in cycles] or [usage["cacheReadInputTokens"]]
        request_context.current().receipt.add_cache(agent_name, [w for w in writes if w], [r for r in reads if r])
    except Exception as e:
        print(f"[LTTM:Tokens] {agent_name} — extraction failed: {e}", flush=True)
    return usage

