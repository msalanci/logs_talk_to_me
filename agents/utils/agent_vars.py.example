def coverage(by_account: dict) -> str:
    """Where a service runs, in words, from a *_REGIONS_BY_ACCOUNT dict:
    "eu-central-1 (main, dev, prod) and us-west-2 (main)".

    Args:
        by_account: The regions of each account ID.

    Returns:
        Each region once, in first-seen order, with the labels of the accounts that cover it.
    """
    regions = []
    for account, names in by_account.items():
        for region in names:
            if region not in regions:
                regions.append(region)
    parts = [f"{region} ({', '.join(ACCOUNTS[a]['label'] for a in by_account if region in by_account[a])})"
             for region in regions]
    return parts[0] if len(parts) == 1 else ", ".join(parts[:-1]) + " and " + parts[-1]

