def sql_list(values: list) -> str:
    """Render values as the inside of a SQL IN list: ['a', 'b'] -> "'a','b'".

    Args:
        values: The values; each is quoted as it is, so none may hold a quote.

    Returns:
        The quoted values, separated by commas; "" for none.
    """
    return ",".join(f"'{value}'" for value in values)

DATE_BLANKS = ("TODAY", "YEAR", "MONTH", "DAY", "PREV_YEAR")


def _utcnow() -> datetime:
    """The current time in UTC.

    Args:
        None.

    Returns:
        A timezone-aware datetime.
    """
    return datetime.now(timezone.utc)


def with_current_date(prompt: str, now: datetime | None = None) -> str:
    """Fill the date blanks of a prompt with the current UTC date (or with `now`).

    Args:
        prompt: The prompt, with blanks such as {TODAY} (DATE_BLANKS).
        now: The time to use; None for now, in UTC.

    Returns:
        The prompt with every blank filled in.
    """
    now = now or _utcnow()
    values = {"TODAY": now.strftime("%Y-%m-%d"), "YEAR": now.strftime("%Y"), "MONTH": now.strftime("%m"),
              "DAY": now.strftime("%d"), "PREV_YEAR": str(now.year - 1)}
    for blank, value in values.items():
        prompt = prompt.replace("{" + blank + "}", value)
    return prompt

